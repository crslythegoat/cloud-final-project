[Unit]
Description=Cloud DB API and dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloud-db
Group=cloud-db
WorkingDirectory=/opt/cloud-db/current
EnvironmentFile=/etc/cloud-db/cloud-db.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cloud-db/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
